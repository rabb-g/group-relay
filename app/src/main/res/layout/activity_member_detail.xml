<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/Widget.JRelay.Header">

            <TextView
                android:id="@+id/text_nickname"
                style="@style/TextAppearance.JRelay.HeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_number"
                style="@style/TextAppearance.JRelay.HeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_stats"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/button_toggle_admin"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_toggle_mute"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_send_dm"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_send_dm"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_edit_nickname"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_edit_nickname"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_edit_number"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_edit_number"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_export_contact"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_export_contact"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_call"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_call"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_text"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_text"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_remove"
                style="@style/Widget.JRelay.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_remove"
                android:layout_marginBottom="24dp" />

            <TextView
                style="@style/TextAppearance.JRelay.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rate_limit_member_section"
                android:layout_marginBottom="6dp" />

            <TextView
                style="@style/TextAppearance.JRelay.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rate_limit_member_desc"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/checkbox_custom_rate_limit"
                style="@style/Widget.JRelay.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkbox_custom_rate_limit"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_rate_limit_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_burst_min" />

                <EditText
                    android:id="@+id/edit_member_burst_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_burst_min"
                    android:inputType="number"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_burst_max" />

                <EditText
                    android:id="@+id/edit_member_burst_max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_burst_max"
                    android:inputType="number"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_min_wait" />

                <EditText
                    android:id="@+id/edit_member_min_wait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_min_wait"
                    android:inputType="number"
                    android:layout_marginBottom="8dp" />

                <TextView
                    style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_max_wait" />

                <EditText
                    android:id="@+id/edit_member_max_wait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_max_wait"
                    android:inputType="number"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/checkbox_member_initial_delay"
                    style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkbox_initial_delay"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

            <Button
                android:id="@+id/button_save_rate_limit"
                style="@style/Widget.JRelay.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_save_rate_limit"
                android:layout_marginBottom="24dp" />

            <TextView
                style="@style/TextAppearance.JRelay.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_activity"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_member_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
