<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Widget.JRelay.Header"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_group_name"
                    style="@style/TextAppearance.JRelay.HeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/TextAppearance.JRelay.HeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/group_name_label" />
            </LinearLayout>

            <Button
                android:id="@+id/button_edit_group_name"
                style="@style/Widget.JRelay.Button.Small.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_group_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_stats_members"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_stats_admins"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_stats_muted"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_stats_messages_today"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_stats_messages_total"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_queue_count"
                style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_next_burst"
                style="@style/TextAppearance.JRelay.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/button_add_member"
                style="@style/Widget.JRelay.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_member_shortcut"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_membership"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_membership"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_rate_limit"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_rate_limit"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_send_group_message"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_group_message_shortcut"
                android:layout_marginBottom="24dp" />

            <TextView
                style="@style/TextAppearance.JRelay.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_activity"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
