<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Empty base styles so the dotted child style names below resolve their implied parent.
         parent="" stops AAPT from also treating "TextAppearance"/"Widget" as implied parents. -->
    <style name="TextAppearance.JRelay" parent="" />
    <style name="Widget.JRelay" parent="" />
    <style name="Widget.JRelay.Badge" />

    <!-- Text appearances -->
    <style name="TextAppearance.JRelay.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.Subtitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.JRelay.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Full-width colored band used at the top of every screen instead of an action bar -->
    <style name="Widget.JRelay.Header">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/primary</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextAppearance.JRelay.HeaderTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="TextAppearance.JRelay.HeaderSubtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.JRelay.Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.JRelay.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.JRelay.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/on_danger</item>
    </style>

    <style name="Widget.JRelay.Button.Small">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.JRelay.Button.Small.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.JRelay.EditText" parent="android:Widget.DeviceDefault.EditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <!-- Checkbox -->
    <style name="Widget.JRelay.CheckBox" parent="android:Widget.DeviceDefault.CompoundButton.CheckBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/focus_highlight</item>
        <item name="android:padding">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- DPAD-focusable row used for members / recent-activity entries -->
    <style name="Widget.JRelay.Row">
        <item name="android:background">@drawable/focus_highlight</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Small colored pill used for the admin / muted badges -->
    <style name="Widget.JRelay.Badge.Admin">
        <item name="android:background">@drawable/bg_badge_admin</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.JRelay.Badge.Muted">
        <item name="android:background">@drawable/bg_badge_muted</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small colored pill shown on the dashboard while a send is active/scheduled -->
    <style name="Widget.JRelay.Badge.Live">
        <item name="android:background">@drawable/bg_badge_live</item>
        <item name="android:textColor">@color/success</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small colored pill for urgent state, e.g. the dashboard's Service Paused indicator -->
    <style name="Widget.JRelay.Badge.Danger">
        <item name="android:background">@drawable/bg_badge_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dropdown selector (Spinner) styled to match text inputs -->
    <style name="Widget.JRelay.Spinner" parent="android:Widget.DeviceDefault.Spinner">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Flat, non-elevated stat tile used in the dashboard/member-detail grid -->
    <style name="Widget.JRelay.Tile">
        <item name="android:background">@drawable/bg_stat_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="TextAppearance.JRelay.TileValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.TileLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
