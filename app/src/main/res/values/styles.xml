<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- jRelay design system.
         Spacing is on a 4dp grid: 16dp page gutters, 24dp between sections, 8dp within a section.
         Touch targets are at least 48dp. Every interactive background has a distinct
         state_focused (DPAD ring) and state_pressed (tint) look. Use start/end only (RTL). -->

    <!-- Empty base styles so the dotted child style names below resolve their implied parent.
         parent="" stops AAPT from also treating "TextAppearance"/"Widget" as implied parents. -->
    <style name="TextAppearance.JRelay" parent="" />
    <style name="Widget.JRelay" parent="" />
    <style name="Widget.JRelay.Badge" />

    <!-- ===== Type scale ===== -->

    <style name="TextAppearance.JRelay.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Heading inside a page -->
    <style name="TextAppearance.JRelay.Subtitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- Short bold label, e.g. a field name next to a value -->
    <style name="TextAppearance.JRelay.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Supporting text under a title or control -->
    <style name="TextAppearance.JRelay.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">1sp</item>
    </style>

    <!-- Small section label. textAllCaps only affects Latin text, so Hebrew/Yiddish read naturally. -->
    <style name="TextAppearance.JRelay.SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Main line of a list/navigation row -->
    <style name="TextAppearance.JRelay.RowTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Second line of a list/navigation row -->
    <style name="TextAppearance.JRelay.RowCaption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- ===== Page structure ===== -->

    <!-- Flat band at the top of every screen instead of an action bar:
         surface colour with a 1dp bottom divider, so hierarchy comes from the title type. -->
    <style name="Widget.JRelay.Header">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_header</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextAppearance.JRelay.HeaderTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.HeaderSubtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- Padded vertical body container under the header -->
    <style name="Widget.JRelay.Page">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <!-- Section heading: 24dp above (section gap), 8dp below -->
    <style name="Widget.JRelay.SectionTitle" parent="TextAppearance.JRelay.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- 1dp full-width hairline between flat rows -->
    <style name="Widget.JRelay.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Label above an input -->
    <style name="Widget.JRelay.FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- Vertical stack of full-width buttons with 8dp gaps between them -->
    <style name="Widget.JRelay.ButtonBar">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:divider">@drawable/spacer_8dp</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- "Nothing here yet" text block -->
    <style name="Widget.JRelay.EmptyState">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">32dp</item>
        <item name="android:paddingBottom">32dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- ===== Banners ===== -->

    <!-- Full-width message strip. Focusable so DPAD users can reach it and act on it. -->
    <style name="Widget.JRelay.Banner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_banner_info</item>
        <item name="android:textColor">@color/on_info_light</item>
    </style>

    <style name="Widget.JRelay.Banner.Info" />

    <style name="Widget.JRelay.Banner.Warning">
        <item name="android:background">@drawable/bg_banner_warning</item>
        <item name="android:textColor">@color/on_warning_light</item>
    </style>

    <style name="Widget.JRelay.Banner.Danger">
        <item name="android:background">@drawable/bg_banner_danger</item>
        <item name="android:textColor">@color/on_danger_light</item>
    </style>

    <style name="Widget.JRelay.Banner.Success">
        <item name="android:background">@drawable/bg_banner_success</item>
        <item name="android:textColor">@color/on_success_light</item>
    </style>

    <!-- ===== Buttons ===== -->

    <!-- Primary filled button. 52dp tall: the fill stays 48dp+ even inside the focus ring gap. -->
    <style name="Widget.JRelay.Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.JRelay.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_button_outline</item>
    </style>

    <style name="Widget.JRelay.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/text_button_danger</item>
    </style>

    <!-- Compact button for inline row actions; still a 48dp target -->
    <style name="Widget.JRelay.Button.Small">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.JRelay.Button.Small.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_button_outline</item>
    </style>

    <!-- ===== Inputs ===== -->

    <style name="Widget.JRelay.EditText" parent="android:Widget.DeviceDefault.EditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <!-- Dropdown selector matching text inputs, with a trailing caret; paddingEnd clears the caret -->
    <style name="Widget.JRelay.Spinner" parent="android:Widget.DeviceDefault.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:popupBackground">@color/surface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Checkbox row: full-width 48dp target with the same focus ring as rows -->
    <style name="Widget.JRelay.CheckBox" parent="android:Widget.DeviceDefault.CompoundButton.CheckBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:buttonTint">@color/primary</item>
        <item name="android:background">@drawable/focus_highlight</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== Rows ===== -->

    <!-- Flat DPAD-focusable row (members, recent activity). Separate rows with Widget.JRelay.Divider. -->
    <style name="Widget.JRelay.Row">
        <item name="android:background">@drawable/focus_highlight</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Tappable navigation row; holds a RowTitle and optional RowCaption -->
    <style name="Widget.JRelay.Row.Nav">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- ===== Badges ===== -->

    <!-- Small tag for admin / muted state -->
    <style name="Widget.JRelay.Badge.Admin">
        <item name="android:background">@drawable/bg_badge_admin</item>
        <item name="android:textColor">@color/on_info_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.JRelay.Badge.Muted">
        <item name="android:background">@drawable/bg_badge_muted</item>
        <item name="android:textColor">@color/on_warning_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shown on the dashboard while a send is active/scheduled -->
    <style name="Widget.JRelay.Badge.Live">
        <item name="android:background">@drawable/bg_badge_live</item>
        <item name="android:textColor">@color/on_success_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Urgent state, e.g. the dashboard's Service Paused indicator -->
    <style name="Widget.JRelay.Badge.Danger">
        <item name="android:background">@drawable/bg_badge_danger</item>
        <item name="android:textColor">@color/on_danger_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Stat tiles ===== -->

    <!-- Flat, non-elevated stat tile used in the dashboard/member-detail grid -->
    <style name="Widget.JRelay.Tile">
        <item name="android:background">@drawable/bg_stat_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="TextAppearance.JRelay.TileValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.JRelay.TileLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

</resources>
