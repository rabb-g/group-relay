    <string name="section_group_mode">Group Mode</string>
    <string name="group_mode_desc">Group mode relays everyone\'s messages as usual. Announcement mode relays only admins\' messages to everyone -- everyone else\'s messages go to admins only. Reply mode relays a message to everyone only when it starts with #all; a plain reply goes just to the member who posted. Can also be changed by text with #mode group / #mode announcement / #mode reply.</string>
    <string name="group_mode_group">Group Mode</string>
    <string name="group_mode_announcement">Announcement Mode</string>
    <string name="group_mode_reply">Reply Mode</string>

    <string name="section_reply_mode">Reply Mode</string>
    <string name="reply_mode_desc">In Reply mode anyone can post to everyone by starting a message with #all. A plain reply goes only to the member who sent the last post you received. Can also be set by text with #mode reply.</string>
    <string name="reply_window_hours_label">Reply window (hours; 0 = no limit)</string>
    <string name="copy_replies_to_admins_label">Copy replies to admins</string>

    <string name="section_staggering">Staggering</string>
    <string name="staggering_desc">Waits between bursts of outgoing messages so sends don\'t all fire at once.</string>
    <string name="checkbox_staggering_enabled">Enable staggering between bursts</string>
    <string name="rate_limit_app_section">Send Pacing</string>
    <string name="rate_limit_app_desc">Applies globally to every relayed message. Not configurable per member.</string>
