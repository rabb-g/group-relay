    <string name="section_message_content">Message Content</string>
    <string name="checkbox_append_sender_number">Append sender\'s number to relayed messages</string>
    <string name="append_sender_number_desc">Adds the sender\'s own number in plain digits (e.g. 2345678910) to the end of every relayed message.</string>
