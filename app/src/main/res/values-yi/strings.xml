    <!-- Consent -->
    <string name="consent_title">איידער איר הייבט אָן</string>
    <string name="consent_body">jRelay שיקט אריבער גרופע-ידיעות דורך שיקן און באקומען געוויינטליכע SMS דורך דעם מכשירס סעלולער פּלאַן. אייער קאמפאניעס געוויינטליכע פּרייזן פאר ידיעות און דאטן קענען גילטן פאר יעדע ידיעה וואס ווערט געשיקט אָדער באקומען.\n\nאיר זענט אליין פאראנטווארטליך צו פאלגן אלע געזעצן, כללים, און קאמפאניע-פּאליסיס וועגן אויטאמאטישע, מאסן, אָדער אומגעבעטענע ידיעות (אריינגערעכנט, אָבער נישט באגרענעצט צו, TCPA און CTIA כללים). די אפליקאציע ווערט געגעבן \"ווי זי איז\", אָן קיין גאראנטיע, און דער דעוועלאפער נעמט נישט קיין אחריות פאר קיין מיסברויך, אפצאלן פאר ידיעות, געזעצליכע פארלעצונגען, אָדער שאדנס פון איר ניצן.\n\nאיר מוזט מסכים זיין צו די תנאים כדי ווייטער צו גיין.</string>
    <string name="consent_license_agree">איך האב געלייענט און בין מסכים צו די תנאים פון דער ליצענץ.</string>
    <string name="consent_agree">איך שטים צו</string>
    <string name="consent_decline">אָפּזאָגן</string>

