<?xml version="1.0" encoding="utf-8"?>
<!-- Background for rows, checkboxes and other non-button targets.
     Focused (DPAD): tinted fill plus a 2dp focus ring. Pressed (touch): tint only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <stroke android:width="2dp" android:color="@color/focus_ring" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pressed_fill" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
